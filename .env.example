# 复制为 .env 后按需修改。所有配置项均以 RELAY_ 为前缀。

# 监听地址与端口
RELAY_HOST=0.0.0.0
RELAY_PORT=8770

# 鉴权口令。留空 = 不校验（本地开发方便）；设置后所有 WS/REST 请求必须带上
RELAY_AUTH_TOKEN=

# 日志级别：DEBUG / INFO / WARNING / ERROR
RELAY_LOG_LEVEL=INFO

# 日志目录，空 = 项目根下 logs/；日志同时输出到控制台和文件
RELAY_LOG_DIR=

# 是否写文件日志（常驻服务建议 true；也可用 run.bat --no-log-file 临时关掉）
RELAY_LOG_TO_FILE=true

# 单个日志文件上限（字节），超过后轮转，默认 10MB
RELAY_LOG_MAX_BYTES=10485760

# 保留几个历史日志文件
RELAY_LOG_BACKUP_COUNT=5

# 允许的跨域来源，逗号分隔，* 表示全部（Vue3 前端需要）
RELAY_ALLOW_ORIGINS=*

# 服务端主动 ping 的间隔（秒）
RELAY_HEARTBEAT_INTERVAL=20

# 客户端多久没有任何消息就判定掉线（秒），应大于 2 倍心跳间隔
RELAY_CLIENT_TIMEOUT=60

# 请求-响应默认超时（秒）
RELAY_REQUEST_TIMEOUT=30

# 单条消息最大字节数，默认 1MB
RELAY_MAX_MESSAGE_BYTES=1048576

# 单连接发送队列长度，队列满说明客户端消费太慢，将被断开
RELAY_OUTBOX_SIZE=256

# 是否向其他客户端广播上下线事件
RELAY_PRESENCE_BROADCAST=true

# ---------------------------------------------------------------------------
# 跨端任务链路追踪（看板：http://<server>:8770/trace）
#
# 数据落在 SQLite（默认 logs/trace/trace.db），**永久保留**；
# 看板默认只显示最近 14 天，但可以筛选到任意区间/全部历史。
# 只记录带 __crossnode__ 标记的跨端信封元数据，payload 只留摘要不留全文。
# ---------------------------------------------------------------------------

# 总开关。false = 埋点直接 return，/api/trace/* 返回 503
RELAY_TRACE_ENABLED=true

# SQLite 文件路径，空 = <RELAY_TRACE_DIR>/trace.db
RELAY_TRACE_DB=

# 追踪数据目录，空 = <日志目录>/trace
RELAY_TRACE_DIR=

# 看板默认显示多少天（只是默认值，页面上可选 30/90 天、全部历史、自定义区间）
RELAY_TRACE_DEFAULT_DAYS=14

# 历史清理天数。0 = 永不删除（默认）。改成比如 365 才会删一年前的数据
RELAY_TRACE_PRUNE_DAYS=0

# 内存里最多缓存多少条活跃任务（仅影响内存，不影响已落盘数据）
RELAY_TRACE_MAX_TASKS=5000

# 单个任务时间线最多保留多少条事件（probe 心跳已折叠，一般远达不到）
RELAY_TRACE_MAX_TIMELINE=60

# payload 摘要长度（字符）。调大更好排查，但磁盘占用与隐私暴露同步增加
RELAY_TRACE_SUMMARY_CHARS=200

# probe 心跳（每任务每分钟 2 条）是否逐条入 events 表。
# 关掉可把数据库缩小一个数量级，任务上的对账轮数与时间线区间仍然保留
RELAY_TRACE_STORE_PROBE_EVENTS=true

# 追踪接口与看板是否需要 token。默认放行（内网随手打开）；
# 公网暴露前务必设为 true —— 任务摘要里带业务正文片段
RELAY_TRACE_REQUIRE_TOKEN=false
